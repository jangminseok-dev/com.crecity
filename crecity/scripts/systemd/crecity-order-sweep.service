[Unit]
Description=crecity 주문 72h 마감 스캔 — 만료 전이 + 마감 임박 알림
Documentation=file:///srv/crecity/crecity/_docs/BOUNDARIES.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=crecity
Group=crecity
WorkingDirectory=/srv/crecity/crecity
Environment=PYTHONPATH=/srv/crecity/crecity:/srv/crecity/crecity/apps
ExecStart=/srv/crecity/.venv/bin/python scripts/order_deadline_sweep.py
SyslogIdentifier=crecity-order-sweep
TimeoutStartSec=4min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
