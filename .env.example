# crecity 환경 변수 — 실제 값은 .env(git 제외)에.
# 키를 추가하면 이 파일에도 반드시 등록하고 crecity/core/config.py에 상수 한 줄을 더한다.

ENV=development

# 로컬 DB — 포트 5433/6380: redoceanmap 백엔드 PC 포워딩(5432/6379)과의 충돌 회피
DATABASE_URL=postgresql://crecity:crecity@localhost:5433/crecity
REDIS_URL=redis://localhost:6380/0

# docker-compose가 읽는 DB 초기값
POSTGRES_USER=crecity
POSTGRES_PASSWORD=crecity
POSTGRES_DB=crecity

# 소셜 로그인(OAuth) — 각 제공자 개발자 콘솔에서 발급. 미설정이면 해당 제공자 로그인만 실패
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 토큰 수명(초) — 기본: 액세스 30분 / 리프레시 14일
AUTH_ACCESS_TOKEN_TTL_SECONDS=1800
AUTH_REFRESH_TOKEN_TTL_SECONDS=1209600

# 주문 정책 — 수수료율(%)·응답 마감(시간). 요율은 주문 생성 시점에 스냅샷됨
ORDER_BRAND_FEE_PERCENT=10
ORDER_CREATOR_FEE_PERCENT=10
ORDER_RESPONSE_DEADLINE_HOURS=72
# 인기 랭킹 — 수락 만료 1건이 상쇄하는 성사 주문 수
RANKING_ACCEPT_EXPIRY_PENALTY=2
# 프로필 심사 정량 기준 — 자동 체크 참고선(자동 승인·반려는 하지 않음). 참여율은 퍼밀(10=1.0%)
VETTING_MIN_FOLLOWERS=1000
VETTING_MIN_ENGAGEMENT_PERMILLE=10

# 토스페이먼츠 — 개발자센터(developers.tosspayments.com)에서 테스트 키 발급
# client는 공개 키(프론트 결제창용), secret은 서버 전용(절대 프론트 노출 금지)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 업로드 파일 저장 루트(crecity/ 기준 상대 경로) — /uploads 정적 경로로 서빙된다
UPLOAD_DIR=uploads
WITHDRAWAL_TAX_PERMILLE=33
